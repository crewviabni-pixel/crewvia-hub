{
  "manifest_version": 3,
  "name": "Crewvia Hub — WhatsApp Bridge",
  "version": "1.0.8",
  "description": "Direct, 1-click automated WhatsApp message sender and CRM bridge for Crewvia Hub without page reloads.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "https://*.lovable.app/*",
    "https://*.lovableproject.com/*",
    "https://bni.crewvia.in/*",
    "https://*.crewvia.in/*",
    "http://bni.crewvia.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "https://*.lovable.app/*",
        "https://*.lovableproject.com/*",
        "https://bni.crewvia.in/*",
        "https://*.crewvia.in/*",
        "http://bni.crewvia.in/*"
      ],
      "js": ["content-crewvia.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": ["content-whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crewvia WhatsApp Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
